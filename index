<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#F8FAFC">
<meta name="description" content="SlideGuide AI — a business-ready AI PPT co-presenter for document-grounded narration, Q&A, summaries, keyword explanations and stakeholder reviews.">
<title>SlideGuide AI — Business PPT Co-Presenter v26</title>

<style>
:root{
  --max:1180px;
  --px:clamp(18px,4vw,64px);
  --font:"Segoe UI", Inter, Roboto, Arial, sans-serif;
  --mono:Consolas,"SFMono-Regular",monospace;

  --bg:#F8FAFC;
  --soft:#EEF6FF;
  --soft2:#EAF3FF;
  --panel:#FFFFFF;
  --ink:#0F172A;
  --text:#25364D;
  --muted:#607088;
  --line:#D2DEEC;

  --blue:#2563EB;
  --blue2:#1E40AF;
  --teal:#0F766E;
  --green:#16A34A;
  --amber:#D97706;
  --navy:#0F172A;

  --shadow:0 12px 28px rgba(15,23,42,.09);
  --shadow-soft:0 8px 20px rgba(15,23,42,.06);
  --radius:18px;
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:17px}
body{
  font-family:var(--font);
  background:var(--bg);
  color:var(--ink);
  line-height:1.56;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
a{text-decoration:none;color:inherit}
button,input{font:inherit}
button{border:0;cursor:pointer}
:focus-visible{outline:3px solid rgba(37,99,235,.3);outline-offset:2px}

/* NAV */
.nav{
  position:sticky;
  top:0;
  z-index:80;
  height:68px;
  padding:0 var(--px);
  display:flex;
  align-items:center;
  gap:18px;
  background:rgba(248,250,252,.96);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
.brand{
  display:flex;
  align-items:center;
  gap:12px;
  font-size:23px;
  font-weight:850;
  letter-spacing:-.03em;
  flex-shrink:0;
}
.brand-mark{
  width:40px;
  height:40px;
  border-radius:13px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,var(--blue),#06B6D4);
  color:#fff;
  font-family:var(--mono);
  font-size:13px;
  font-weight:900;
}
.nav-links{
  display:flex;
  align-items:center;
  gap:6px;
  margin-left:auto;
}
.nav-links a{
  padding:9px 10px;
  border-radius:10px;
  color:#394B63;
  font-family:var(--mono);
  font-size:12.5px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.055em;
}
.nav-links a:hover{background:#EAF1FF;color:var(--blue)}
.nav-cta{
  min-height:38px;
  padding:0 16px;
  border-radius:13px;
  display:inline-flex;
  align-items:center;
  gap:7px;
  background:var(--blue);
  color:#fff;
  font-family:var(--mono);
  font-size:12px;
  font-weight:900;
  letter-spacing:.055em;
  text-transform:uppercase;
  box-shadow:0 8px 18px rgba(37,99,235,.2);
}
.nav-cta:hover{background:var(--blue2)}
.menu{
  display:none;
  margin-left:auto;
  width:42px;
  height:42px;
  border-radius:13px;
  background:#EAF1FF;
  color:var(--blue);
  font-size:24px;
}
.drawer{
  display:none;
  position:fixed;
  top:76px;
  left:12px;
  right:12px;
  z-index:90;
  background:#fff;
  border:1px solid var(--line);
  border-radius:16px;
  box-shadow:var(--shadow);
  padding:8px;
}
.drawer.open{display:block}
.drawer a{
  display:block;
  padding:13px;
  border-radius:12px;
  color:var(--text);
  font-family:var(--mono);
  font-size:12.5px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.055em;
}
.drawer a:hover{background:#EAF1FF;color:var(--blue)}

/* COMMON */
.btn{
  min-height:46px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:0 18px;
  border-radius:13px;
  background:var(--blue);
  color:#fff;
  font-family:var(--mono);
  font-size:12.5px;
  font-weight:900;
  letter-spacing:.055em;
  text-transform:uppercase;
  white-space:nowrap;
  box-shadow:0 8px 18px rgba(37,99,235,.18);
}
.btn:hover{background:var(--blue2)}
.btn.secondary{
  background:#fff;
  color:var(--ink);
  border:1px solid var(--line);
  box-shadow:none;
}
.btn.secondary:hover{border-color:var(--blue);color:var(--blue);background:#F3F7FF}

.section{
  padding:54px var(--px);
  scroll-margin-top:92px;
  border-top:1px solid rgba(210,222,236,.68);
}
.section.soft{background:var(--soft)}
.section-inner{width:min(100%,var(--max));margin:0 auto}
.section-head{
  display:grid;
  grid-template-columns:1fr .78fr;
  gap:24px;
  align-items:center;
  margin-bottom:28px;
}
.kicker{
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-bottom:12px;
  color:var(--blue);
  font-family:var(--mono);
  font-size:15px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.kicker::before{content:"";width:26px;height:2px;background:var(--blue);border-radius:99px}
h1,h2,h3{letter-spacing:-.025em}
.section-title{
  font-size:clamp(35px,3.7vw,50px);
  line-height:1.08;
  font-weight:880;
}
.section-copy{
  color:var(--text);
  font-size:clamp(17px,1.1vw,19px);
  line-height:1.55;
  max-width:640px;
}
.section-copy-box{
  background:#FFFFFF;
  border:1px solid #C9D8EE;
  border-left:4px solid var(--blue);
  border-radius:16px;
  padding:14px 16px;
  box-shadow:var(--shadow-soft);
}
.section-copy-box strong{color:var(--blue);font-weight:900}
.section-copy-box p{margin:0}

.card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:22px;
  box-shadow:var(--shadow-soft);
}
.card h3{font-size:23px;line-height:1.18;margin-bottom:8px;font-weight:850}
.card p{font-size:17.5px;color:var(--text)}

/* HERO */
.hero{
  padding:26px var(--px) 34px;
  background:linear-gradient(180deg,#F8FAFC 0%,#EFF6FF 100%);
  border-bottom:1px solid var(--line);
}
.hero-inner{
  width:min(100%,var(--max));
  margin:0 auto;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
  align-items:center;
}
.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:9px;
  margin-bottom:14px;
  padding:8px 13px;
  border-radius:999px;
  background:#ECFDF5;
  border:1px solid #BBF7D0;
  color:#087B5F;
  font-family:var(--mono);
  font-size:12.5px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.06em;
}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green)}
.hero-title{
  font-size:clamp(40px,4.7vw,62px);
  line-height:1.01;
  font-weight:920;
  letter-spacing:-.048em;
  margin-bottom:16px;
}
.hero-title span{color:var(--blue)}
.hero-body{
  font-size:clamp(16.5px,1.08vw,18px);
  color:var(--text);
  max-width:650px;
  margin-bottom:16px;
}
.actions{display:flex;flex-wrap:wrap;gap:11px}
.hero-note{
  margin-top:10px;
  padding:9px 12px;
  border:1px solid #C7D8F2;
  border-radius:14px;
  background:#fff;
  color:var(--text);
  font-size:14.5px;
  line-height:1.45;
}
.hero-note strong{color:var(--ink)}
.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:9px;
  margin-top:10px;
}
.stat{
  background:#fff;
  border:1px solid var(--line);
  border-radius:14px;
  padding:9px 11px;
  box-shadow:var(--shadow-soft);
}
.stat-num{font-size:24px;line-height:1;font-weight:920;color:var(--blue)}
.stat-label{
  margin-top:5px;
  font-family:var(--mono);
  font-size:10.8px;
  font-weight:900;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.05em;
}

/* VISUAL + CAROUSEL */
.visual{
  background:#fff;
  border:1px solid var(--line);
  border-radius:24px;
  box-shadow:var(--shadow);
  overflow:hidden;
}
.visual-top{
  height:44px;
  display:flex;
  align-items:center;
  gap:7px;
  padding:0 14px;
  background:#F1F5F9;
  border-bottom:1px solid var(--line);
}
.tdot{width:9px;height:9px;border-radius:50%;background:#94A3B8}
.url{
  flex:1;
  background:#fff;
  border:1px solid var(--line);
  border-radius:9px;
  padding:5px 9px;
  color:var(--muted);
  font-family:var(--mono);
  font-size:11.5px;
}
.visual-body{padding:10px;display:grid;gap:8px}
.carousel-shell{
  display:grid;
  gap:10px;
}
.carousel{
  position:relative;
  min-height:230px;
  border-radius:18px;
  overflow:hidden;
  background:#0F172A;
}
.slide{
  position:absolute;
  inset:0;
  opacity:0;
  transform:translateX(14px);
  transition:opacity .3s ease, transform .3s ease;
  padding:16px 18px;
  display:none;
  grid-template-columns:1.05fr .82fr;
  gap:14px;
  align-items:center;
  color:#fff;
}
.slide.active{
  display:grid;
  opacity:1;
  transform:none;
  z-index:2;
}
.slide h3{
  font-size:clamp(20px,1.55vw,24px);
  line-height:1.08;
  margin-bottom:8px;
  font-weight:880;
}
.slide p{font-size:13.2px;color:#E5EEFF;line-height:1.42;max-width:340px}
.slide-steps{display:grid;gap:7px;margin-top:11px}
.slide-step{
  display:flex;
  align-items:center;
  gap:8px;
  color:#E5EEFF;
  font-size:13.2px;
  line-height:1.22;
}
.slide-step span{
  width:23px;
  height:23px;
  border-radius:7px;
  background:rgba(255,255,255,.18);
  display:grid;
  place-items:center;
  font-family:var(--mono);
  font-size:10px;
  font-weight:900;
  flex:0 0 auto;
}
.image-card{
  min-height:140px;
  border-radius:15px;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.18);
  padding:10px;
  display:grid;
  place-items:center;
}
.image-card svg{width:100%;height:auto;max-height:136px}
.compact-visual{align-self:center}
.carousel-controls{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:0 2px;
}
.carousel-caption{
  font-family:var(--mono);
  font-size:11.5px;
  font-weight:900;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.05em;
}
.carousel-dots{
  display:flex;
  gap:8px;
  align-items:center;
  justify-content:flex-end;
}
.cdot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:#B9C7DA;
  border:1px solid transparent;
}
.cdot.active{background:var(--blue);border-color:var(--blue)}
.visual-cards{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.vcard{
  border:1px solid var(--line);
  border-radius:13px;
  padding:10px 11px;
  background:#fff;
}
.vcard strong{
  display:block;
  font-size:12.5px;
  color:var(--blue);
  font-family:var(--mono);
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.055em;
  margin-bottom:4px;
}
.vcard p{font-size:14.5px;color:var(--text);line-height:1.35}

/* USP */
.usp-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}
.usp-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  padding:20px;
  box-shadow:var(--shadow-soft);
}
.usp-card strong{
  display:block;
  font-size:19px;
  line-height:1.2;
  margin-bottom:6px;
}
.usp-card p{font-size:17px;color:var(--text)}

/* AUDIENCE USE CASES */
.use-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}
.use-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  padding:21px;
  box-shadow:var(--shadow-soft);
}
.use-card .role{
  display:inline-flex;
  margin-bottom:9px;
  color:var(--blue);
  font-family:var(--mono);
  font-size:11.5px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.055em;
}
.use-card h3{font-size:22px;margin-bottom:7px}
.use-card p{font-size:16.3px;color:var(--text)}

/* FEATURES */
.feature-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
}
.feature-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  padding:19px;
  box-shadow:var(--shadow-soft);
  min-height:174px;
}
.icon{
  width:42px;
  height:42px;
  border-radius:13px;
  display:grid;
  place-items:center;
  background:#EFF6FF;
  color:var(--blue);
  font-size:21px;
  margin-bottom:11px;
}
.feature-card h3{
  font-size:20px;
  line-height:1.18;
  margin-bottom:7px;
  font-weight:850;
}
.feature-card p{font-size:16.5px;color:var(--text)}
.tag{
  margin-top:10px;
  display:inline-flex;
  padding:4px 8px;
  border-radius:999px;
  background:#EFF6FF;
  color:var(--blue);
  font-family:var(--mono);
  font-size:10.5px;
  font-weight:900;
  text-transform:uppercase;
}

/* HOW */
.flow-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}
.flow-card{padding:18px}
.flow-item{
  display:flex;
  gap:12px;
  padding:12px 0;
  border-bottom:1px solid var(--line);
}
.flow-item:last-child{border-bottom:0}
.flow-num{
  width:33px;
  height:33px;
  border-radius:10px;
  background:#EFF6FF;
  color:var(--blue);
  display:grid;
  place-items:center;
  font-family:var(--mono);
  font-size:11.5px;
  font-weight:900;
  flex:0 0 auto;
}
.flow-title{font-size:17px;font-weight:850;margin-bottom:2px}
.flow-desc{font-size:15px;color:var(--text)}
.component-table{width:100%;border-collapse:collapse}
.component-table tr{border-bottom:1px solid var(--line)}
.component-table tr:last-child{border-bottom:0}
.component-table td{
  padding:12px 0;
  font-size:15.5px;
  vertical-align:top;
}
.component-table td:first-child{
  padding-right:12px;
  white-space:nowrap;
  color:var(--blue);
  font-family:var(--mono);
  font-size:11.5px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.045em;
}
.component-table td:last-child{color:var(--text)}

/* AUDIO */
.audio-layout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}
.mode-list{display:grid;gap:9px;margin-bottom:13px}
.mode{
  display:flex;
  align-items:center;
  gap:11px;
  text-align:left;
  background:#fff;
  border:1px solid var(--line);
  border-radius:15px;
  padding:13px;
}
.mode.active,.mode:hover{border-color:var(--blue);background:#F3F7FF}
.mode-dot{width:11px;height:11px;border-radius:50%;background:#CBD5E1}
.mode.active .mode-dot{background:var(--blue)}
.mode-title{display:block;font-size:17px;font-weight:850}
.mode small{font-size:13.5px;color:var(--muted)}
.audio-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  padding:18px;
  box-shadow:var(--shadow-soft);
}
.player-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-bottom:11px;
}
.player-title{font-size:17px;font-weight:850}
.player-num{font-family:var(--mono);font-size:11.5px;color:var(--muted)}
.wave{
  height:46px;
  display:flex;
  align-items:center;
  gap:3px;
  background:#F1F5F9;
  border-radius:14px;
  padding:0 8px;
  overflow:hidden;
  margin-bottom:11px;
}
.bar{width:3px;border-radius:2px;background:#CBD5E1}
.bar.played{background:var(--blue)}
.bar.active{background:#06B6D4}
.progress-row{display:flex;align-items:center;gap:8px;margin-bottom:11px}
.time{font-family:var(--mono);font-size:11.5px;color:var(--muted);min-width:36px}
.track{height:6px;flex:1;background:#E2E8F0;border-radius:999px;overflow:hidden}
.fill{height:100%;background:var(--blue);width:0}
.controls{display:flex;align-items:center;gap:8px}
.ctrl{
  width:38px;
  height:38px;
  border-radius:50%;
  background:#EFF6FF;
  color:var(--blue);
  display:grid;
  place-items:center;
}
.ctrl.play{width:44px;height:44px;background:var(--blue);color:#fff}
.speed{
  margin-left:auto;
  border:1px solid var(--line);
  border-radius:10px;
  background:#fff;
  color:var(--text);
  padding:8px 10px;
  font-family:var(--mono);
  font-size:11.5px;
  font-weight:900;
}
.volume{display:flex;gap:8px;align-items:center;margin-top:10px}
.volume input{flex:1;accent-color:var(--blue)}
.audio-status{
  margin-top:10px;
  background:#F1F5F9;
  border-radius:12px;
  padding:10px 11px;
  color:var(--text);
  font-family:var(--mono);
  font-size:12px;
  font-weight:850;
}



/* FAQ - compact website accordion */
.faq-section{
  background:linear-gradient(180deg,#F8FBFF 0%,#FFFFFF 100%);
  padding-top:clamp(44px,6vw,74px);
  padding-bottom:clamp(54px,7vw,90px);
}
.faq-panel{
  width:min(100%,1120px);
  margin:0 auto;
  background:#fff;
  border:1px solid var(--line);
  border-radius:26px;
  box-shadow:var(--shadow-soft);
  padding:clamp(22px,3vw,38px);
}
.faq-heading{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  margin-bottom:clamp(18px,2.5vw,28px);
}
.faq-heading h2{
  margin:0;
  color:var(--ink);
  font-size:clamp(30px,4vw,52px);
  line-height:1.04;
  letter-spacing:-.04em;
  font-weight:950;
}
.faq-heading-line{
  flex:1;
  height:1px;
  background:linear-gradient(90deg,var(--line),transparent);
}
.faq-list{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px 16px;
}
.faq-item{
  background:#fff;
  border:1px solid var(--line);
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 10px 26px rgba(15,23,42,.045);
}
.faq-q{
  width:100%;
  min-height:58px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  padding:15px 17px;
  background:#fff;
  color:var(--ink);
  text-align:left;
  font-size:clamp(16px,1.08vw,18px);
  line-height:1.28;
  font-weight:900;
  cursor:pointer;
}
.faq-q:hover{background:#F6F9FF}
.faq-icon{
  flex:0 0 auto;
  width:28px;
  height:28px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#EEF5FF;
  color:var(--blue);
  font-size:18px;
  font-weight:900;
  transition:transform .18s ease,background .18s ease,color .18s ease;
}
.faq-a{
  max-height:0;
  overflow:hidden;
  color:var(--text);
  font-size:clamp(15px,1vw,16.5px);
  line-height:1.55;
  padding:0 17px;
  transition:max-height .24s ease,padding .24s ease;
}
.faq-item.open .faq-a{
  max-height:220px;
  padding:0 17px 16px;
}
.faq-item.open .faq-icon{transform:rotate(45deg);background:var(--blue);color:#fff}
@media (max-width:760px){
  .faq-section{padding-top:38px;padding-bottom:48px}
  .faq-panel{border-radius:20px;padding:16px}
  .faq-heading{margin-bottom:16px}

<button class="back-top" id="backTop" aria-label="Back to top">↑</button>

<script>
'use strict';

/* Navigation */
const menuBtn=document.getElementById('menuBtn');
const drawer=document.getElementById('drawer');
menuBtn.addEventListener('click',()=>{
  const open=drawer.classList.toggle('open');
  menuBtn.textContent=open?'×':'☰';
  menuBtn.setAttribute('aria-expanded',String(open));
});
drawer.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{
  drawer.classList.remove('open');
  menuBtn.textContent='☰';
  menuBtn.setAttribute('aria-expanded','false');
}));



/* FAQ accordion */
const faqRoot=document.querySelector('[data-faq-root]');
if(faqRoot){
  const faqItems=[...faqRoot.querySelectorAll('.faq-item')];
  function openFaq(item, open){
    item.classList.toggle('open', open);
    const btn=item.querySelector('.faq-q');
    if(btn) btn.setAttribute('aria-expanded', String(open));
  }
  faqItems.forEach(item=>{
    const btn=item.querySelector('.faq-q');
    if(btn){
      btn.addEventListener('click',()=>{
        const shouldOpen=!item.classList.contains('open');
        faqItems.forEach(i=>openFaq(i,false));
        openFaq(item,shouldOpen);
      });
    }
  });
}

/* Back to top */
const backTop=document.getElementById('backTop');
window.addEventListener('scroll',()=>backTop.classList.toggle('show',window.scrollY>420),{passive:true});
backTop.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));

/* Reveal */
const revealObserver=new IntersectionObserver(entries=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      entry.target.classList.add('in');
      revealObserver.unobserve(entry.target);
    }
  });
},{threshold:.1,rootMargin:'0px 0px -20px 0px'});
document.querySelectorAll('.reveal').forEach(el=>revealObserver.observe(el));

/* Carousel - dots outside the card so they cannot overlap slide text */
const heroSlides=[...document.querySelectorAll('#heroCarousel .slide')];
const dotWrap=document.getElementById('carouselDots');
let heroIndex=0;
let carouselTimer=null;
heroSlides.forEach((_,i)=>{
  const d=document.createElement('button');
  d.type='button';
  d.className='cdot'+(i===0?' active':'');
  d.setAttribute('aria-label','Show carousel slide '+(i+1));
  d.addEventListener('click',()=>{setHeroSlide(i);restartCarousel();});
  dotWrap.appendChild(d);
});
function setHeroSlide(i){
  heroIndex=i;
  heroSlides.forEach((s,idx)=>s.classList.toggle('active',idx===i));
  dotWrap.querySelectorAll('.cdot').forEach((d,idx)=>d.classList.toggle('active',idx===i));
}
function restartCarousel(){
  clearInterval(carouselTimer);
  carouselTimer=setInterval(()=>setHeroSlide((heroIndex+1)%heroSlides.length),3800);
}
restartCarousel();

/* Audio preview */
const SLIDES=[
  {title:'Title Slide',num:1,seconds:11,text:'SlideGuide AI is an AI powered PPT co-presenter that helps teams present better and answer safer.'},
  {title:'Key Win of the Month',num:2,seconds:15,text:'This slide explains the key win of the month in a simple stakeholder friendly way.'},
  {title:'Delivery Impact',num:3,seconds:15,text:'This section explains delivery impact across automation, downloads, fund pages and reusable patterns.'},
  {title:'Platform Health Score',num:4,seconds:13,text:'This slide helps the audience understand platform stability and health.'},
  {title:'Core Web Vitals',num:5,seconds:15,text:'This slide explains performance metrics such as LCP and CLS in simple language.'},
  {title:'Issue Tracker Summary',num:6,seconds:15,text:'This slide summarises open, completed and in progress issues.'},
  {title:'Strategic Observations',num:7,seconds:14,text:'This section highlights observations, risks and possible next steps.'},
  {title:'Closing',num:8,seconds:10,text:'The closing slide wraps up the walkthrough and prepares for questions.'}
];
let slideIndex=1,playing=false,progress=0,timer=null,rate=1,voiceMode='male';
const playerTitle=document.getElementById('playerTitle');
const playerNum=document.getElementById('playerNum');
const waveform=document.getElementById('waveform');
const fill=document.getElementById('fill');
const currentTime=document.getElementById('currentTime');
const totalTime=document.getElementById('totalTime');
const playBtn=document.getElementById('playBtn');
const prevBtn=document.getElementById('prevBtn');
const nextBtn=document.getElementById('nextBtn');
const speedBtn=document.getElementById('speedBtn');
const volRange=document.getElementById('volRange');
const volIcon=document.getElementById('volIcon');
const audioStatus=document.getElementById('audioStatus');

function buildBars(){
  waveform.innerHTML='';
  for(let i=0;i<44;i++){
    const b=document.createElement('div');
    b.className='bar';
    b.style.height=(10+Math.round((Math.abs(Math.sin(i*.45))+Math.abs(Math.cos(i*.22)))*11))+'px';
    waveform.appendChild(b);
  }
}
function fmt(sec){
  const m=Math.floor(sec/60),s=Math.floor(sec%60);
  return m+':'+String(s).padStart(2,'0');
}
function syncAudio(){
  const slide=SLIDES[slideIndex];
  playerTitle.textContent=slide.title;
  playerNum.textContent='Slide '+slide.num+' / '+SLIDES.length;
  totalTime.textContent=fmt(slide.seconds);
  currentTime.textContent=fmt(slide.seconds*progress/100);
  fill.style.width=progress+'%';
  const bars=waveform.querySelectorAll('.bar');
  const active=Math.round(progress/100*bars.length);
  bars.forEach((bar,i)=>{
    bar.className='bar'+(i<active-1?' played':i===active-1?' active':'');
  });
  playBtn.textContent=playing?'Ⅱ':'▶';
}
function voices(){
  return ('speechSynthesis' in window)?speechSynthesis.getVoices():[];
}
function pickVoice(mode){
  const vs=voices();
  const femaleNames=/female|zira|heera|susan|samantha|aria|sonia|natasha|neerja|kavya|microsoft heera|google uk english female/i;
  const maleNames=/male|david|mark|ravi|aarav|guy|microsoft ravi|google uk english male/i;
  if(mode==='female'){
    return vs.find(v=>/en-IN/i.test(v.lang)&&femaleNames.test(v.name))||
           vs.find(v=>femaleNames.test(v.name)&&/^en/i.test(v.lang))||
           vs.find(v=>/en-IN/i.test(v.lang))||
           vs.find(v=>/^en/i.test(v.lang))||
           vs[0]||null;
  }
  if(mode==='male'){
    return vs.find(v=>/en-IN/i.test(v.lang)&&maleNames.test(v.name))||
           vs.find(v=>maleNames.test(v.name)&&/^en/i.test(v.lang))||
           vs.find(v=>/en-IN/i.test(v.lang))||
           vs.find(v=>/^en/i.test(v.lang))||
           vs[0]||null;
  }
  return vs.find(v=>/en-IN/i.test(v.lang))||vs.find(v=>/^en/i.test(v.lang))||vs[0]||null;
}
function speak(){
  if(!('speechSynthesis' in window)){
    audioStatus.textContent='Browser voice not supported';
    return;
  }
  speechSynthesis.cancel();
  const utterance=new SpeechSynthesisUtterance(SLIDES[slideIndex].text);
  const voice=pickVoice(voiceMode);
  if(voice) utterance.voice=voice;
  utterance.lang=(voice&&voice.lang)||'en-IN';
  utterance.rate=rate;
  utterance.volume=Number(volRange.value)/100;
  utterance.pitch=voiceMode==='female'?1.3:voiceMode==='male'?0.92:1;
  utterance.onstart=()=>audioStatus.textContent=(voiceMode==='female'?'Female':'Male')+' voice preview playing'+(voice?' — '+voice.name:'');
  utterance.onerror=()=>{audioStatus.textContent='Voice preview unavailable';stop(false);};
  utterance.onend=()=>{stop(false);progress=100;syncAudio();};
  speechSynthesis.speak(utterance);
}
function start(){
  if(progress>=100)progress=0;
  playing=true;
  speak();
  clearInterval(timer);
  timer=setInterval(()=>{
    if(!playing)return;
    progress=Math.min(100,progress+(100/(SLIDES[slideIndex].seconds*10))*rate);
    syncAudio();
    if(progress>=100)stop(false);
  },100);
  syncAudio();
}
function stop(cancel=true){
  playing=false;
  clearInterval(timer);
  timer=null;
  if(cancel&&'speechSynthesis'in window) speechSynthesis.cancel();
  if(cancel) audioStatus.textContent=voiceMode==='female'?'Female presenter selected':'Male presenter selected';
  syncAudio();
}
function changeSlide(delta){
  stop(true);
  slideIndex=Math.max(0,Math.min(SLIDES.length-1,slideIndex+delta));
  progress=0;
  syncAudio();
}
buildBars();
syncAudio();
if('speechSynthesis'in window) speechSynthesis.onvoiceschanged=()=>voices();
playBtn.addEventListener('click',()=>playing?stop(true):start());
prevBtn.addEventListener('click',()=>changeSlide(-1));
nextBtn.addEventListener('click',()=>changeSlide(1));
speedBtn.addEventListener('click',()=>{
  rate=rate===1?1.2:rate===1.2?.85:1;
  speedBtn.textContent=rate+'×';
  if(playing){stop(true);start();}
});
volRange.addEventListener('input',()=>{
  const v=Number(volRange.value);
  volIcon.textContent=v===0?'🔇':v<40?'🔉':'🔊';
  if(playing){stop(true);start();}
});
document.querySelectorAll('.mode').forEach(btn=>btn.addEventListener('click',()=>{
  stop(true);
  document.querySelectorAll('.mode').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  voiceMode=btn.dataset.voice;
  const voice=pickVoice(voiceMode);
  const label=voiceMode==='female'?'Female presenter selected':'Male presenter selected';
  audioStatus.textContent=label+(voice?' — '+voice.name:'');
}));

/* Q&A removed in v30: this page now explains the concept only.
   Audience Q&A remains inside the working PPT demo. */
window.__SLIDEGUIDE_V34_HEALTH__ = function(){
  return {
    version: 'v34',
    faqTitle: document.querySelector('#faq h2')?.textContent || '',
    faqItems: document.querySelectorAll('#faq .faq-item').length,
    demoLink: document.querySelectorAll('a[href*="ppt-demo.html"]').length
  };
};
</script>

</body>
